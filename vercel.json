{
  "$schema": "https://vercel.sh",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite",
      "installCommand": "npm install --legacy-peer-deps",
      "buildCommand": "npm run build"
    },
    "server": {
      "root": "server",
      "framework": "express",
      "buildCommand": "npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "client"
      }
    },
    {
      "source": "/vite.svg",
      "destination": {
        "service": "client"
      }
    },
    {
      "source": "/favicon.ico",
      "destination": {
        "service": "client"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client",
        "path": "/index.html"
      }
    }
  ]
}
