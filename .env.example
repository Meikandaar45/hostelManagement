# Environment variables — copy to .env and fill in real values
# NEVER commit .env to version control

# ─── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Client URL (for CORS) ─────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Database ──────────────────────────────────────────────
# Option A — single URL (mysql2 will parse it)
DATABASE_URL=mysql://root:password@localhost:3306/hostel_management

# Option B — individual vars (used if DATABASE_URL is absent)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=password
# DB_NAME=hostel_management

# ─── JWT ───────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d

# ─── Cookie ────────────────────────────────────────────────
# Set to 'true' only in production (requires HTTPS)
COOKIE_SECURE=false

# ─── Rate Limiting ─────────────────────────────────────────
# Rate limiting for sensitive authentication endpoints
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20

