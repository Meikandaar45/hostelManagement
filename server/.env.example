# Server Environment Variables Template
# Copy to server/.env and fill in real values
# NEVER commit server/.env to version control

NODE_ENV=development
PORT=5000

# Client Origin for CORS (comma-separated origins or single origin)
# Example: https://my-hostel.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173
# CORS_ORIGIN=https://my-hostel.vercel.app

# Database Configuration
# Option A: Full Connection URL (e.g. Aiven, PlanetScale, Railway, AWS RDS)
DATABASE_URL=mysql://db_user:db_password@remote-db-host:3306/hostel_management

# Option B: Individual Connection Parameters
# DB_HOST=remote-db-host
# DB_PORT=3306
# DB_USER=db_user
# DB_PASSWORD=your_secure_password
# DB_NAME=hostel_management

# JWT Secret & Expiration
# Generate secret with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_string_minimum_64_characters
JWT_EXPIRES_IN=7d

# Cookie Security & SameSite Policy
# Set COOKIE_SECURE=true in production with HTTPS
COOKIE_SECURE=false
# Use 'none' for cross-domain cookies (Vercel frontend + separate backend domain with HTTPS)
# Use 'lax' for same-domain or proxied deployments
COOKIE_SAME_SITE=lax

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20
